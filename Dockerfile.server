# Shared immutable base: identical Node.js, musl and runtime libraries in every stage.
# Update the version and verified multi-platform digest together for security updates.
FROM node:26.13.0-alpine3.24@sha256:c6ad9e9c1d80f6eb607c26b4b0a132ff7a2344fad1c78ea3baa2a7d4c8de6d94 AS node-base

RUN node -e 'if (process.version !== "v26.13.0") throw new Error("Unexpected Node.js version")'

FROM node-base AS client-builder

RUN npm install -g yarn@1.22.22

WORKDIR /app

COPY vendor/guacamole-client/guacamole-common-js/ ./vendor/guacamole-client/guacamole-common-js/

WORKDIR /app/client

COPY client/package.json client/yarn.lock ./
RUN set -eu; for i in 1 2 3; do \
        if yarn install --frozen-lockfile --network-timeout 500000; then break; fi; \
        if [ "$i" -eq 3 ]; then exit 1; fi; \
        sleep 15; \
    done

COPY client/ .
RUN yarn build


FROM node-base AS schema-builder

WORKDIR /app

RUN apk add --no-cache flatc
RUN npm install -g esbuild@0.28.1

COPY schema/ schema/
COPY package.json ./

RUN mkdir -p server/lib/generated && \
    flatc --ts --ts-flat-files -o server/lib/generated schema/control_plane.fbs schema/sftp_protocol.fbs && \
    esbuild server/lib/generated/nexterm/control-plane.ts --bundle --format=cjs --outfile=server/lib/generated/control_plane_generated.js --allow-overwrite --platform=node --external:flatbuffers && \
    esbuild server/lib/generated/nexterm/sftp-protocol.ts --bundle --format=cjs --outfile=server/lib/generated/sftp_protocol_generated.js --allow-overwrite --platform=node --external:flatbuffers && \
    rm -rf server/lib/generated/nexterm


FROM node-base AS server-builder

ARG VERSION

WORKDIR /app

RUN apk add --no-cache \
    python3 py3-pip py3-setuptools \
    make g++ gcc build-base \
    jq

RUN npm install -g yarn@1.22.22

COPY package.json yarn.lock ./
RUN if [ -n "$VERSION" ]; then \
        jq --arg v "$VERSION" '.version = $v' package.json > tmp.json && mv tmp.json package.json; \
    fi
RUN set -eu; for i in 1 2 3; do \
        if yarn install --production --frozen-lockfile --network-timeout 500000; then break; fi; \
        if [ "$i" -eq 3 ]; then exit 1; fi; \
        sleep 15; \
    done

RUN rm -rf node_modules/@img/sharp-libvips-linux-x64 \
           node_modules/@img/sharp-linux-x64 \
           node_modules/@img/sharp-linux-arm64 \
           node_modules/@img/sharp-libvips-linux-arm64

COPY server/ server/
COPY --from=schema-builder /app/server/lib/generated/ server/lib/generated/


FROM node-base

# Preserve the previous image's direct /bin/sh startup behavior.
ENTRYPOINT []

ENV NODE_ENV=production
ENV LOG_LEVEL=system

WORKDIR /app

COPY --from=client-builder /app/client/dist ./dist
COPY --from=server-builder /app/server ./server
COPY --from=server-builder /app/node_modules ./node_modules
COPY --from=server-builder /app/package.json ./

# Exercise the copied native modules in the actual runtime, without build tools.
# No application data, credentials or production database are used here.
RUN node -e 'const assert = require("node:assert/strict"); \
    const bcrypt = require("bcrypt"); \
    const hash = bcrypt.hashSync("native-smoke-test", 4); \
    assert(bcrypt.compareSync("native-smoke-test", hash)); \
    assert(!bcrypt.compareSync("wrong-password", hash)); \
    const db = new (require("sqlite3").Database)(":memory:"); \
    db.get("SELECT 42 AS answer", (err, row) => { \
        if (err) throw err; \
        assert.equal(row.answer, 42); \
        db.close(err => { if (err) throw err; }); \
    }); \
    console.log(JSON.stringify({node: process.version, modules: process.versions.modules, napi: process.versions.napi, arch: process.arch}));'

COPY docker-start.sh .
RUN chmod +x docker-start.sh

RUN printf '#!/bin/sh\nexec node /app/server/cli/index.js "$@"\n' > /usr/local/bin/ntctl \
    && chmod +x /usr/local/bin/ntctl

EXPOSE 6989

CMD ["/bin/sh", "docker-start.sh"]
